generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int             @id @default(autoincrement())
  createdAt             DateTime        @default(now())
  name                  String?
  email                 String          @unique
  supervisorId          Int?
  sponsorId             Int?
  passwordHash          String?
  feedbackOnly          Boolean @default(false)
  notificationPreferences NotificationPreferences?
  activityEmails ActivityEmail[]
  role                  UserRole        @default(STUDENT)
  emailVerified         DateTime?
  pendingEmail          String?
  subscriptionType      SubscriptionType @default(FREE_TRIAL)
  subscriptionStartedAt DateTime        @default(now())
  subscriptionExpiresAt DateTime?
  goCardlessCustomerId  String?
  goCardlessMandateId   String?
  goCardlessSubscriptionId String?
  goCardlessSubscriptionStatus String?
  sponsorSubscriptionInactive Boolean   @default(false)
  sponsor               User?           @relation("UserSponsor", fields: [sponsorId], references: [id])
  sponsoredUsers        User[]          @relation("UserSponsor")
  Comment               Comment[]
  sentNotifications     Notification[]  @relation("ActorNotifications")
  receivedNotifications Notification[]  @relation("RecipientNotifications")
  supervisedProjects    Project[]       @relation("ProjectSupervisor")
  memberships           ProjectMember[]
  assignedTasks         Task[]          @relation("TaskAssignee")
  flaggedTasks          Task[]          @relation("FlaggedTasks")
  taskSets              TaskSet[]
  collaboratorProjects  Project[]       @relation("ProjectCollaborators")
  studentProjects       Project[]       @relation("ProjectStudents")
  multiAssignedTasks    Task[]          @relation("TaskAssignments")
  projectUpdates        ProjectUpdate[]
  projectFiles          ProjectFile[]
  emailVerifications    EmailVerification[]
  passwordResets        PasswordResetToken[]
  goCardlessRedirectFlows GoCardlessRedirectFlow[]
  blockedEmailsCreated  BlockedEmail[]  @relation("BlockedByAdmin")
  feedbackWorks FeedbackWork[]
  feedbackSettings FeedbackSettings?
  feedbackPresets FeedbackPreset[]
}

model Project {
  id            Int             @id @default(autoincrement())
  title         String          @unique
  description   String?
  supervisorId  Int
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime        @default(now())
  category      String?
  updatedAt     DateTime        @updatedAt
  isCompleted   Boolean         @default(false)
  archived      Boolean         @default(false)
  status        String          @default("On Track")
  notifications Notification[]
  supervisor    User            @relation("ProjectSupervisor", fields: [supervisorId], references: [id])
  members       ProjectMember[]
  tasks         Task[]
  updates       ProjectUpdate[]
  files         ProjectFile[]
  collaborators User[]          @relation("ProjectCollaborators")
  students      User[]          @relation("ProjectStudents")
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
}

model Task {
  id               Int            @id @default(autoincrement())
  projectId        Int
  title            String
  description      String?
  dueDate          DateTime?
  dependencyTaskId Int?
  flagged          Boolean        @default(false)
  flaggedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  assigneeId       Int?
  duration         Int?
  kind             String         @default("TASK")
  startDate        DateTime?
  status           TaskStatus     @default(TODO)
  flaggedByUserId  Int?
  comments         Comment[]
  notifications    Notification[]
  assignee         User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  flaggedBy        User?          @relation("FlaggedTasks", fields: [flaggedByUserId], references: [id])
  project          Project        @relation(fields: [projectId], references: [id])
  assignedUsers    User[]         @relation("TaskAssignments")

  @@index([projectId])
  @@unique([projectId, title])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  createdAt DateTime @default(now())
  content   String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id          Int      @id @default(autoincrement())
  projectId   Int?
  taskId      Int?
  actorId     Int
  recipientId Int
  type        String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  actor       User     @relation("ActorNotifications", fields: [actorId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  recipient   User     @relation("RecipientNotifications", fields: [recipientId], references: [id])
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([projectId])
}

model EmailLog {
  id                Int      @id @default(autoincrement())
  to                String
  subject           String
  messagePreview    String
  status            String
  provider          String?
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  newEmail  String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TaskSet {
  id           Int            @id @default(autoincrement())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  supervisorId Int
  name         String
  scheduleStartDate DateTime?
  supervisor   User           @relation(fields: [supervisorId], references: [id])
  templates    TaskTemplate[] @relation("TaskSetTemplates")
}

model GoCardlessRedirectFlow {
  id           Int      @id @default(autoincrement())
  userId       Int
  flowId       String   @unique
  sessionToken String   @unique
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TaskTemplate {
  id          Int      @id @default(autoincrement())
  description String?
  taskSetId   Int
  createdAt   DateTime @default(now())
  dueOffset   Int?
  order       Int?
  title       String
  duration    Int?
  startOffset Int?
  dueTime     String?
  kind        String   @default("TASK")
  taskSet     TaskSet  @relation("TaskSetTemplates", fields: [taskSetId], references: [id], onDelete: Cascade)
}

model ProjectUpdate {
  id          Int      @id @default(autoincrement())
  projectId   Int
  userId      Int
  title       String
  description String?
  notifyAll   Boolean  @default(true)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@map("project_updates")
}

model ProjectFile {
  id        Int       @id @default(autoincrement())
  projectId Int
  userId    Int
  name      String
  url       String
  type      FileItemType @default(FILE)
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@map("project_files")
}

model BlockedEmail {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  reason      String?
  createdAt   DateTime @default(now())
  blockedById Int?
  blockedBy   User?    @relation("BlockedByAdmin", fields: [blockedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum FileItemType {
  FILE
  FOLDER
}

enum UserRole {
  SUPERVISOR
  STUDENT
  COLLABORATOR
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BEHIND_SCHEDULE
  AT_RISK
  COMPLETE
  BLOCKED
  REVIEW
  DEFERRED
  DONE
}

enum SubscriptionType {
  ADMIN_APPROVED
  SUBSCRIBED
  FREE_TRIAL
  SPONSORED
  CANCELLED
}


model FeedbackWork {
  id Int @id @default(autoincrement())
  supervisorId Int
  supervisor User @relation(fields: [supervisorId], references: [id])
  recipientName String
  recipientEmail String
  title String
  workType String
  createdAt DateTime @default(now())
  nextVersion Int @default(1)
  reviews FeedbackReview[]
  @@index([supervisorId])
  @@index([recipientEmail])
}

model FeedbackReview {
  id Int @id @default(autoincrement())
  workId Int
  work FeedbackWork @relation(fields: [workId], references: [id])
  version Int
  status String @default("RECEIVED")
  receivedDate String
  estimateStart String
  estimateEnd String
  completedAt DateTime?
  turnaroundWorkingDays Int?
  queuePosition Int?
  cancellationReason String?
  trackingToken String @unique
  lastRequestDate String?
  receiptEmailClaimedAt DateTime?
  completionEmailClaimedAt DateTime?
  receiptEmailSentAt DateTime?
  completionEmailSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history FeedbackEvent[]
  @@unique([workId, version])
  @@index([status, estimateEnd])
}

model FeedbackEvent {
  id Int @id @default(autoincrement())
  reviewId Int
  review FeedbackReview @relation(fields: [reviewId], references: [id])
  type String
  message String
  createdAt DateTime @default(now())
  @@index([reviewId])
}

model FeedbackSettings {
  userId Int @id
  user User @relation(fields: [userId], references: [id])
  dailySummaryEnabled Boolean @default(false)
  lastSummaryDate String?
}

model FeedbackPreset {
  id Int @id @default(autoincrement())
  supervisorId Int
  supervisor User @relation(fields: [supervisorId], references: [id])
  name String
  minDays Int?
  maxDays Int?
  @@unique([supervisorId, name])
}


model NotificationPreferences {
  userId Int @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskComments String @default("IMMEDIATE")
  taskFlags String @default("IMMEDIATE")
  projectStatus String @default("IMMEDIATE")
  deadlineSummary Boolean @default(true)
  taskAssignments Boolean @default(true)
  taskDeadlineChanges Boolean @default(true)
}

model ActivityEmail {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey String
  category String
  subject String
  message String
  projectId Int
  taskId Int?
  deliveryMode String
  status String @default("PENDING")
  claimedAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId, eventKey])
  @@index([status, userId])
}

model ScheduledJobRun {
  key String @id
  claimedAt DateTime?
  completedAt DateTime?
}
